# Database Connection (Neon PostgreSQL or standard PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@pooler-host/dbname?sslmode=require"

# Owner Authentication
# Optional: Set a master passcode via environment variable, or configure on first launch in the UI.
OWNER_PASSCODE=""
# Optional: Secret for signing HTTP-only owner session cookies (auto-persisted if omitted).
SESSION_SECRET=""

# LocalSites.pro MCP Server Configuration (kept strictly server-side)
# Supported values: demo | http_sse | stdio
LOCALSITES_MCP_TRANSPORT="demo"
LOCALSITES_MCP_URL=""
LOCALSITES_MCP_API_KEY=""
LOCALSITES_MCP_STDIO_COMMAND=""
LOCALSITES_MCP_STDIO_ARGS=""

# Runtime Server
PORT="3000"
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
